# SmartBilling Server Environment Variables Template
# Copy this file to .env and replace placeholder values with your real configuration.
# DO NOT commit real secrets to source control.

PORT=5000
NODE_ENV=development

# Database Configuration (MySQL / TiDB)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_database_password_here
DB_NAME=smartbilling_db

# Authentication Secret
JWT_SECRET=your_super_secret_jwt_key_here
